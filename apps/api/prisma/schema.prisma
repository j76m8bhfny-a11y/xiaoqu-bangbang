generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// 用户与小区
// ============================

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  openid             String    @unique
  unionid            String?
  phone              String?
  nickname           String
  avatarUrl          String    @map("avatar_url")
  bio                String?
  status             String    @default("active") // active/banned/deleted
  lastLoginAt        DateTime? @map("last_login_at")
  currentCommunityId String?   @map("current_community_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  currentCommunity        Community?                    @relation("UserCurrentCommunity", fields: [currentCommunityId], references: [id])
  communityMembers        CommunityMember[]
  verifications           Verification[]
  events                  Event[]                       @relation("EventCreator")
  selectedHelperEvents    Event[]                       @relation("EventSelectedHelper")
  eventApplications       EventApplication[]
  eventLikes              EventLike[]
  eventThanksSent         EventThank[]                  @relation("EventThankFromUser")
  eventThanksReceived     EventThank[]                  @relation("EventThankToUser")
  eventFavorites          EventFavorite[]
  eventComments           EventComment[]
  marketComments          MarketComment[]               @relation("MarketCommentUser")
  marketLikes             MarketLike[]
  announcementLikes       AnnouncementLike[]
  completionConfirmations EventCompletionConfirmation[]
  notifications           Notification[]
  marketItems             MarketItem[]                  @relation("MarketSeller")
  boughtItems             MarketItem[]                  @relation("MarketBuyer")
  marketInterests         MarketInterest[]
  marketReviews           MarketReview[]                @relation("MarketReviewReviewer")
  marketReviewsReceived   MarketReview[]                @relation("MarketReviewReviewee")
  contributions           ContributionRecord[]
  userBadges              UserBadge[]
  rankingSnapshots        RankingSnapshot[]             @relation("RankingSnapshotUser")
  committeeClaims         CommitteeMemberClaim[]        @relation("CommitteeClaimUser")
  voteRecords             VoteRecord[]                  @relation("VoteRecordUser")
  reports                 Report[]                      @relation("ReportReporter")
  reportsHandled          Report[]                      @relation("ReportHandler")
  auditLogs               AuditLog[]
  adminUser               AdminUser?
  topics                  Topic[]                       @relation("TopicCreator")
  topicsClosed            Topic[]                       @relation("TopicCloser")
  topicComments           TopicComment[]
  topicLikes              TopicLike[]
  topicRatings            TopicRating[]
  topicCommentLikes       TopicCommentLike[]
  topicMergeResolved      TopicMergeSuggestion[]        @relation("TopicMergeResolver")
  communityApplications   CommunityApplication[]        @relation("ApplicationApplicant")
  communityApplicationSupports CommunityApplicationSupport[] @relation("ApplicationSupporter")

  @@index([phone])
  @@index([currentCommunityId])
  @@map("users")
}

model Community {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  city      String
  district  String
  address   String
  status    String    @default("active") // active/inactive
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  currentCommunityUsers  User[]                  @relation("UserCurrentCommunity")
  members                CommunityMember[]
  socialGroups           CommunitySocialGroup[]
  verifications          Verification[]
  events                 Event[]
  marketItems            MarketItem[]
  banners                Banner[]
  serviceProviders       ServiceProvider[]
  committeeMembers       CommitteeMember[]
  committeeAnnouncements CommitteeAnnouncement[]
  committeeClaims        CommitteeMemberClaim[]  @relation("CommitteeClaimCommunity")
  votes                  Vote[]
  voteRecords            VoteRecord[]            @relation("VoteRecordCommunity")
  userBadges             UserBadge[]
  contributions          ContributionRecord[]
  rankingSnapshots       RankingSnapshot[]       @relation("RankingSnapshotCommunity")
  notifications          Notification[]
  shareLogs              ShareLog[]              @relation("ShareLogCommunity")
  feedbackLogs           FeedbackProcessLog[]
  reports                Report[]
  adminUsers             AdminUser[]
  topics                 Topic[]
  topicMergeSuggestions  TopicMergeSuggestion[]

  @@map("communities")
}

model CommunitySocialGroup {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  title       String
  description String?
  qrImageUrl  String?  @map("qr_image_url")
  contactText String?  @map("contact_text")
  visibleTo   String   @default("verified_only") @map("visible_to") // verified_only/public
  status      String   @default("active") // active/inactive
  sortOrder   Int      @default(0) @map("sort_order")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id])

  @@index([communityId, status, sortOrder])
  @@map("community_social_groups")
}

model CommunityMember {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  communityId  String    @map("community_id") @db.Uuid
  building     String?
  roomMasked   String?   @map("room_masked")
  role         String    @default("resident") // resident/committee_admin/platform_admin/volunteer
  verifyStatus String    @default("unverified") @map("verify_status") // unverified/pending/verified/rejected
  joinedAt     DateTime  @default(now()) @map("joined_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId, role])
  @@index([userId])
  @@map("community_members")
}

model Verification {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  communityId           String    @map("community_id") @db.Uuid
  materialType          String    @map("material_type") // property_cert/rent_contract/access_card/other
  originalFileUrl       String?   @map("original_file_url")
  originalFileDeletedAt DateTime? @map("original_file_deleted_at")
  maskedFileUrl         String?   @map("masked_file_url")
  ocrResultJson         Json?     @map("ocr_result_json")
  aiResultJson          Json?     @map("ai_result_json")
  consentSnapshot       Json?     @map("consent_snapshot")
  status                String    @default("pending") // pending/approved/rejected/manual_review
  rejectReason          String?   @map("reject_reason")
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@index([userId, communityId])
  @@index([status])
  @@map("verifications")
}

// ============================
// 通知
// ============================

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String?   @map("community_id") @db.Uuid
  type        String // review_result/event_response/completion/badge/feedback/vote/announcement/system
  title       String
  content     String
  targetType  String?   @map("target_type") // event/market/vote etc.
  targetId    String?   @map("target_id") @db.Uuid
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user      User       @relation(fields: [userId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================
// 事件系统
// ============================

model Event {
  id               String    @id @default(uuid()) @db.Uuid
  communityId      String    @map("community_id") @db.Uuid
  creatorId        String    @map("creator_id") @db.Uuid
  type             String // help_request/public_welfare/lost_found/public_feedback/discussion (help_offer 已废弃，仅兼容历史数据)
  title            String
  description      String
  images           Json      @default("[]")
  videos           Json      @default("[]")
  rewardType       String    @default("none") @map("reward_type") // free/paid/negotiable/none
  rewardAmount     Decimal?  @map("reward_amount") @db.Decimal
  locationText     String?   @map("location_text")
  expectedTime     DateTime? @map("expected_time")
  eventTime        DateTime? @map("event_time")
  capacity         Int?
  isAnonymous      Boolean   @default(false) @map("is_anonymous")
  visibility       String    @default("public") // public/admin_only
  status           String    @default("pending_review") // pending_review/open/in_progress/processing/completed/closed/rejected
  aiReviewStatus   String    @default("pending") @map("ai_review_status") // pending/pass/reject/manual_review
  aiReviewResult   Json?     @map("ai_review_result")
  selectedHelperId String?   @map("selected_helper_id") @db.Uuid
  completedAt      DateTime? @map("completed_at")
  viewCount        Int       @default(0) @map("view_count")
  likeCount        Int       @default(0) @map("like_count")
  commentCount     Int       @default(0) @map("comment_count")
  thanksCount      Int       @default(0) @map("thanks_count")
  topicId          String?   @map("topic_id") @db.Uuid
  aiComment        String?   @map("ai_comment")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  community               Community                     @relation(fields: [communityId], references: [id])
  creator                 User                          @relation("EventCreator", fields: [creatorId], references: [id])
  selectedHelper          User?                         @relation("EventSelectedHelper", fields: [selectedHelperId], references: [id], onDelete: SetNull)
  applications            EventApplication[]
  comments                EventComment[]
  likes                   EventLike[]
  thanks                  EventThank[]
  favorites               EventFavorite[]
  completionConfirmations EventCompletionConfirmation[]
  feedbackLogs            FeedbackProcessLog[]
  topic                   Topic?                        @relation(fields: [topicId], references: [id])
  topicComments           TopicComment[]

  @@index([communityId, type, status, createdAt])
  @@index([creatorId])
  @@index([selectedHelperId])
  @@index([aiReviewStatus])
  @@index([topicId])
  @@map("events")
}

model EventApplication {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  actionType String    @map("action_type") // help/need_help/join/provide_clue/follow/participate_discussion
  message    String?
  status     String    @default("pending") // pending/selected/cancelled/rejected/confirmed
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId, actionType])
  @@index([eventId, status])
  @@map("event_applications")
}

model EventCompletionConfirmation {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  role          String // creator/helper/participant/admin
  status        String    @default("requested") // requested/confirmed
  rating        Int?
  ratingContent String?   @map("rating_content")
  ratingTags    Json?     @map("rating_tags")
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId, role])
  @@map("event_completion_confirmations")
}

model EventComment {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  content        String
  aiReviewStatus String    @default("pending") @map("ai_review_status") // pending/pass/reject/manual_review
  status         String    @default("visible") // visible/hidden/deleted
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  event   Event          @relation(fields: [eventId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  parent  EventComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies EventComment[] @relation("CommentReplies")

  @@index([eventId, createdAt])
  @@map("event_comments")
}

model EventLike {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_likes")
}

model EventThank {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  event    Event @relation(fields: [eventId], references: [id])
  fromUser User  @relation("EventThankFromUser", fields: [fromUserId], references: [id])
  toUser   User  @relation("EventThankToUser", fields: [toUserId], references: [id])

  @@unique([eventId, fromUserId, toUserId])
  @@map("event_thanks")
}

model EventFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_favorites")
}

model Report {
  id          String    @id @default(uuid()) @db.Uuid
  reporterId  String    @map("reporter_id") @db.Uuid
  targetType  String    @map("target_type") // event/event_comment/market_item/market_comment/user
  targetId    String    @map("target_id") @db.Uuid
  communityId String?   @map("community_id") @db.Uuid
  reason      String // privacy/false_info/harassment/illegal/ad_spam/other
  description String?
  status      String    @default("pending") // pending/processed/rejected
  handledBy   String?   @map("handled_by") @db.Uuid
  handledAt   DateTime? @map("handled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  reporter  User       @relation("ReportReporter", fields: [reporterId], references: [id])
  handler   User?      @relation("ReportHandler", fields: [handledBy], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  @@map("reports")
}

model FeedbackProcessLog {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  operatorId      String   @map("operator_id") @db.Uuid
  communityId     String?  @map("community_id") @db.Uuid
  status          String // received/processing/contacted/resolved/cannot_resolve/closed
  content         String
  images          Json?    @default("[]")
  visibleToPublic Boolean  @default(true) @map("visible_to_public")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  event     Event      @relation(fields: [eventId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  @@index([eventId, createdAt])
  @@map("feedback_process_logs")
}

// ============================
// 闲置系统
// ============================

model MarketItem {
  id             String    @id @default(uuid()) @db.Uuid
  communityId    String    @map("community_id") @db.Uuid
  sellerId       String    @map("seller_id") @db.Uuid
  category       String // free/furniture/baby/books/pet/digital/other
  title          String
  description    String
  images         Json      @default("[]")
  price          Decimal?  @db.Decimal
  tradeType      String    @map("trade_type") // sell/free/exchange
  conditionLevel String    @map("condition_level") // new/like_new/good/used/old
  contactText    String?   @map("contact_text")
  status         String    @default("pending_review") // pending_review/on_sale/sold/closed/rejected
  likeCount      Int       @default(0) @map("like_count")
  aiReviewStatus String    @default("pending") @map("ai_review_status") // pending/pass/reject/manual_review
  aiReviewResult Json?     @map("ai_review_result")
  buyerId        String?   @map("buyer_id") @db.Uuid
  soldAt         DateTime? @map("sold_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  community Community         @relation(fields: [communityId], references: [id])
  seller    User              @relation("MarketSeller", fields: [sellerId], references: [id])
  buyer     User?             @relation("MarketBuyer", fields: [buyerId], references: [id])
  comments  MarketComment[]
  reviews   MarketReview[]
  likes     MarketLike[]
  interests MarketInterest[]

  @@index([communityId, category, status, createdAt])
  @@index([sellerId])
  @@index([buyerId])
  @@map("market_items")
}

model MarketInterest {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  message   String?
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  item MarketItem @relation(fields: [itemId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
  @@index([itemId])
  @@map("market_interests")
}

model MarketLike {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  item MarketItem @relation(fields: [itemId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
  @@map("market_likes")
}

model MarketComment {
  id             String    @id @default(uuid()) @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  content        String
  aiReviewStatus String    @default("pending") @map("ai_review_status") // pending/pass/reject/manual_review
  status         String    @default("visible") // visible/hidden/deleted
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  item    MarketItem      @relation(fields: [itemId], references: [id])
  user    User            @relation("MarketCommentUser", fields: [userId], references: [id])
  parent  MarketComment?  @relation("MarketCommentReplies", fields: [parentId], references: [id])
  replies MarketComment[] @relation("MarketCommentReplies")

  @@index([itemId, createdAt])
  @@map("market_comments")
}

model MarketReview {
  id             String    @id @default(uuid()) @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  reviewerId     String    @map("reviewer_id") @db.Uuid
  revieweeId     String    @map("reviewee_id") @db.Uuid
  rating         Int
  tags           Json?
  content        String?
  status         String    @default("visible") // visible/hidden/deleted
  aiReviewStatus String    @default("pending") @map("ai_review_status") // pending/pass/reject/manual_review
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  item     MarketItem @relation(fields: [itemId], references: [id])
  reviewer User       @relation("MarketReviewReviewer", fields: [reviewerId], references: [id])
  reviewee User       @relation("MarketReviewReviewee", fields: [revieweeId], references: [id])

  @@unique([itemId, reviewerId, revieweeId])
  @@index([revieweeId, createdAt])
  @@map("market_reviews")
}

// ============================
// 榜单、贡献与奖章
// ============================

model Badge {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String
  iconUrl     String?   @map("icon_url")
  ruleJson    Json      @map("rule_json")
  status      String    @default("active") // active/inactive
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  badgeId     String   @map("badge_id") @db.Uuid
  sourceType  String   @map("source_type") // event/market/manual
  sourceId    String?  @map("source_id") @db.Uuid
  awardedBy   String?  @map("awarded_by") @db.Uuid
  awardedAt   DateTime @default(now()) @map("awarded_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])
  badge     Badge     @relation(fields: [badgeId], references: [id])

  @@index([userId, communityId])
  @@index([communityId, awardedAt])
  @@map("user_badges")
}

model ContributionRecord {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  sourceType  String    @map("source_type") // event/market/feedback/manual
  sourceId    String    @map("source_id") @db.Uuid
  action      String // help_free/help_paid/public_welfare/lost_found/feedback/market/good_review/manual
  score       Int
  flowerCount Int       @map("flower_count")
  reason      String
  occurredAt  DateTime  @map("occurred_at")
  status      String    @default("valid") // valid/pending_review/invalid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, sourceType, sourceId, action])
  @@index([communityId, userId, occurredAt])
  @@map("contribution_records")
}

model RankingSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  periodType  String   @map("period_type") // total/month
  periodKey   String   @map("period_key") // total 或 YYYY-MM
  userId      String   @map("user_id") @db.Uuid
  rankNo      Int      @map("rank_no")
  score       Int
  flowerCount Int      @map("flower_count")
  helpCount   Int      @map("help_count")
  badgeCount  Int      @map("badge_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation("RankingSnapshotCommunity", fields: [communityId], references: [id])
  user      User      @relation("RankingSnapshotUser", fields: [userId], references: [id])

  @@index([communityId, periodType, periodKey])
}

// ============================
// 业委会与投票
// ============================

model CommitteeMember {
  id             String    @id @default(uuid()) @db.Uuid
  communityId    String    @map("community_id") @db.Uuid
  name           String
  position       String
  avatarUrl      String?   @map("avatar_url")
  responsibility String?
  termStart      DateTime? @map("term_start") @db.Date
  termEnd        DateTime? @map("term_end") @db.Date
  claimedUserId  String?   @map("claimed_user_id") @db.Uuid
  claimStatus    String    @default("unclaimed") @map("claim_status") // unclaimed/pending/claimed/rejected
  status         String    @default("active") // active/inactive
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  community Community              @relation(fields: [communityId], references: [id])
  claims    CommitteeMemberClaim[]

  @@index([communityId])
  @@map("committee_members")
}

model CommitteeMemberClaim {
  id                String    @id @default(uuid()) @db.Uuid
  committeeMemberId String    @map("committee_member_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  communityId       String    @map("community_id") @db.Uuid
  statement         String
  materialUrls      Json      @map("material_urls")
  aiReviewResult    Json?     @map("ai_review_result")
  status            String    @default("pending") // pending/approved/rejected/manual_review
  rejectReason      String?   @map("reject_reason")
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  committeeMember CommitteeMember @relation(fields: [committeeMemberId], references: [id])
  user            User            @relation("CommitteeClaimUser", fields: [userId], references: [id])
  community       Community       @relation("CommitteeClaimCommunity", fields: [communityId], references: [id])

  @@unique([committeeMemberId, userId])
  @@index([communityId])
  @@map("committee_member_claims")
}

model CommitteeAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  title       String
  content     String
  images      Json      @default("[]")
  publisherId String    @map("publisher_id") @db.Uuid
  isPinned    Boolean   @default(false) @map("is_pinned")
  status      String    @default("draft") // draft/published/hidden
  likeCount   Int       @default(0) @map("like_count")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  community Community          @relation(fields: [communityId], references: [id])
  likes     AnnouncementLike[]

  @@index([communityId])
  @@map("committee_announcements")
}

model AnnouncementLike {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  announcement CommitteeAnnouncement @relation(fields: [announcementId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@map("announcement_likes")
}

model Vote {
  id                 String    @id @default(uuid()) @db.Uuid
  communityId        String    @map("community_id") @db.Uuid
  title              String
  description        String
  voteType           String    @map("vote_type") // single/multiple
  maxChoices         Int?      @map("max_choices")
  resultVisibility   String    @default("always") @map("result_visibility") // always/after_vote/after_end/admin_only
  isAnonymous        Boolean   @default(false) @map("is_anonymous")
  startAt            DateTime  @map("start_at")
  endAt              DateTime  @map("end_at")
  status             String    @default("draft") // draft/published/closed
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  community Community    @relation(fields: [communityId], references: [id])
  options   VoteOption[]
  records   VoteRecord[]

  @@index([communityId])
  @@map("votes")
}

model VoteOption {
  id        String   @id @default(uuid()) @db.Uuid
  voteId    String   @map("vote_id") @db.Uuid
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  vote Vote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@map("vote_options")
}

model VoteRecord {
  id                String   @id @default(uuid()) @db.Uuid
  voteId            String   @map("vote_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  communityId       String   @map("community_id") @db.Uuid
  selectedOptionIds Json     @map("selected_option_ids")
  ipHash            String?  @map("ip_hash")
  userAgentHash     String?  @map("user_agent_hash")
  votedAt           DateTime @default(now()) @map("voted_at")
  createdAt         DateTime @default(now()) @map("created_at")

  vote      Vote      @relation(fields: [voteId], references: [id])
  user      User      @relation("VoteRecordUser", fields: [userId], references: [id])
  community Community @relation("VoteRecordCommunity", fields: [communityId], references: [id])

  @@unique([voteId, userId])
  @@index([voteId])
  @@index([communityId])
  @@map("vote_records")
}

// ============================
// Banner 与服务商
// ============================

model Banner {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String?   @map("community_id") @db.Uuid
  title       String
  subtitle    String?
  imageUrl    String    @map("image_url")
  linkType    String    @default("none") @map("link_type") // event/market/announcement/service_provider/url/none
  linkId      String?   @map("link_id") @db.Uuid
  linkUrl     String?   @map("link_url")
  position    String    @default("home_top") // home_top/event_list/market_list
  sortOrder   Int       @default(0) @map("sort_order")
  status      String    @default("draft") // draft/published/offline
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  community Community? @relation(fields: [communityId], references: [id])

  @@index([communityId])
  @@map("banners")
}

model ServiceProvider {
  id                   String    @id @default(uuid()) @db.Uuid
  communityId          String    @map("community_id") @db.Uuid
  name                 String
  category             String // repair/cleaning/lock/home_appliance/moving/pet/other
  logoUrl              String?   @map("logo_url")
  coverUrl             String?   @map("cover_url")
  description          String
  contactText          String    @map("contact_text")
  serviceArea          String?   @map("service_area")
  recommendationSource String    @default("platform") @map("recommendation_source") // platform/committee/community
  verifyStatus         String    @default("unverified") @map("verify_status") // unverified/verified/rejected
  status               String    @default("pending_review") // pending_review/published/offline/rejected
  sortOrder            Int       @default(0) @map("sort_order")
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  community Community @relation(fields: [communityId], references: [id])

  @@index([communityId, category, status, sortOrder])
  @@map("service_providers")
}

// ============================
// AI 审核与审计
// ============================

model AiReviewLog {
  id           String   @id @default(uuid()) @db.Uuid
  targetType   String   @map("target_type") // event/comment/market_item/verification/committee_claim/banner/service_provider
  targetId     String   @map("target_id") @db.Uuid
  inputSummary Json     @map("input_summary")
  result       String // pass/reject/manual_review
  labels       Json?
  score        Decimal? @db.Decimal
  rawResult    Json?    @map("raw_result")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("ai_review_logs")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @unique @map("user_id") @db.Uuid
  username     String    @unique
  passwordHash String?   @map("password_hash")
  role         String // platform_admin/committee_admin
  communityId  String?   @map("community_id") @db.Uuid
  status       String    @default("active") // active/disabled
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user      User?      @relation(fields: [userId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  @@map("admin_users")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  operatorId   String   @map("operator_id") @db.Uuid
  operatorRole String   @map("operator_role")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  detailJson   Json     @map("detail_json")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  operator User @relation(fields: [operatorId], references: [id])

  @@index([operatorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ============================
// 分享/转发
