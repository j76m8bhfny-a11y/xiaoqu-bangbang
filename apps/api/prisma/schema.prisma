// ============================
// 议事榜
// ============================

model Topic {
  id                 String    @id @default(uuid()) @db.Uuid
  communityId        String    @map("community_id") @db.Uuid
  title              String
  description        String?
  status             String    @default("open") // open / closed
  likeCount          Int       @default(0) @map("like_count")
  dislikeCount       Int       @default(0) @map("dislike_count")
  closedLikeCount    Int       @default(0) @map("closed_like_count")
  closedDislikeCount Int       @default(0) @map("closed_dislike_count")
  ratingSum          Int       @default(0) @map("rating_sum")
  ratingCount        Int       @default(0) @map("rating_count")
  eventCount         Int       @default(0) @map("event_count")
  commentCount       Int       @default(0) @map("comment_count")
  closedSummary      String?   @map("closed_summary")
  closedAt           DateTime? @map("closed_at")
  closedBy           String?   @map("closed_by") @db.Uuid
  createdBy          String    @map("created_by") @db.Uuid
  aiReviewStatus     String    @default("pending") @map("ai_review_status")
  aiReviewResult     Json?     @map("ai_review_result")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  community                Community              @relation(fields: [communityId], references: [id])
  creator                  User                   @relation("TopicCreator", fields: [createdBy], references: [id])
  closer                   User?                  @relation("TopicCloser", fields: [closedBy], references: [id])
  events                   Event[]
  comments                 TopicComment[]
  likes                    TopicLike[]
  ratings                  TopicRating[]
  mergeSuggestionsAsTarget TopicMergeSuggestion[] @relation("MergeTarget")
  mergeSuggestionsAsSource TopicMergeSuggestion[] @relation("MergeSource")

  @@index([communityId, status, likeCount])
  @@map("topics")
}

model TopicComment {
  id             String   @id @default(uuid()) @db.Uuid
  topicId        String   @map("topic_id") @db.Uuid
  eventId        String?  @map("event_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  content        String
  images         Json     @default("[]")
  likeCount      Int      @default(0) @map("like_count")
  dislikeCount   Int      @default(0) @map("dislike_count")
  replyCount     Int      @default(0) @map("reply_count")
  aiReviewStatus String   @default("pending") @map("ai_review_status")
  status         String   @default("visible")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  topic   Topic              @relation(fields: [topicId], references: [id])
  event   Event?             @relation(fields: [eventId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  parent  TopicComment?      @relation("TopicCommentReplies", fields: [parentId], references: [id])
  replies TopicComment[]     @relation("TopicCommentReplies")
  likes   TopicCommentLike[]

  @@index([topicId, eventId, likeCount])
  @@map("topic_comments")
}

model TopicLike {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String // like / dislike
  scope     String   @default("open") // open / closed
  createdAt DateTime @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([topicId, userId, scope])
  @@map("topic_likes")
}

model TopicRating {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([topicId, userId])
  @@map("topic_ratings")
}

model TopicCommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String // like / dislike
  createdAt DateTime @default(now()) @map("created_at")

  comment TopicComment @relation(fields: [commentId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@map("topic_comment_likes")
}

model TopicMergeSuggestion {
  id            String    @id @default(uuid()) @db.Uuid
  communityId   String    @map("community_id") @db.Uuid
  sourceTopicId String    @map("source_topic_id") @db.Uuid
  targetTopicId String    @map("target_topic_id") @db.Uuid
  similarity    Float
  status        String    @default("pending") // pending / approved / rejected
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?   @map("resolved_by") @db.Uuid

  community   Community @relation(fields: [communityId], references: [id])
  sourceTopic Topic     @relation("MergeSource", fields: [sourceTopicId], references: [id])
  targetTopic Topic     @relation("MergeTarget", fields: [targetTopicId], references: [id])
  resolver    User?     @relation("TopicMergeResolver", fields: [resolvedBy], references: [id])

  @@index([communityId, status])
  @@map("topic_merge_suggestions")
}

// ============================
// 小区申请（用户自助开通小区）
// ============================

model CommunityApplication {
  id                  String    @id @default(uuid()) @db.Uuid
  applicantId         String    @map("applicant_id") @db.Uuid
  name                String
  city                String
  district            String
  address             String
  estimatedHouseholds Int?      @map("estimated_households")
  reason              String?
  materialType        String    @map("material_type") // property_cert/rent_contract/access_card/other
  materialUrl         String    @map("material_url")
  doorPhotoUrl        String?   @map("door_photo_url")
  status              String    @default("pending") // pending/approving/approved/rejected
  rejectReason        String?   @map("reject_reason")
  approvedCommunityId String?   @map("approved_community_id") @db.Uuid
  supportCount        Int       @default(0) @map("support_count")
  reviewedAt          DateTime? @map("reviewed_at")
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  applicant User                          @relation("ApplicationApplicant", fields: [applicantId], references: [id])
  supports  CommunityApplicationSupport[]

  @@index([status, supportCount])
  @@index([applicantId])
  @@map("community_applications")
}

model CommunityApplicationSupport {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  application CommunityApplication @relation(fields: [applicationId], references: [id])
  user        User                 @relation("ApplicationSupporter", fields: [userId], references: [id])

  @@unique([applicationId, userId])
  @@index([userId])
  @@map("community_application_supports")
}
