model ShareLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  communityId String?  @map("community_id") @db.Uuid
  targetType  String   @map("target_type") // home/event/market/ranking/badge/announcement/vote/service_provider
  targetId    String?  @map("target_id") @db.Uuid
  channel     String // friend/timeline/poster/copy_link/open_from_share
  shareTitle  String?  @map("share_title")
  sharePath   String?  @map("share_path")
  imageUrl    String?  @map("image_url")
  shareToken  String?  @unique @map("share_token")
  scene       String?
