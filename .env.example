# ===== 小区帮榜棒 - 全局环境变量 =====
# 复制为 .env 后修改

# ===== 数据库 =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xiaoqu_bangbang

# ===== JWT =====
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ===== 微信小程序 =====
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# ===== 对象存储 =====
# STORAGE_TYPE=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ===== AI 审核 (首版 mock) =====
AI_REVIEW_PROVIDER=mock

# ===== OCR (首版 mock) =====
OCR_PROVIDER=mock

# ===== 环境 =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===== 管理后台 =====
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
